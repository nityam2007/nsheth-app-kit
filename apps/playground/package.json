{
  "name": "playground",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "post-cta-init": "npx -y create-db@latest --user-agent tanstack/tsrouter",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "test": "node --import tsx --test src/publication.test.ts src/slug.test.ts src/payments.test.ts src/errors.test.ts",
    "build:cloudflare": "vite build --config vite.cloudflare.config.ts",
    "deploy:cloudflare": "wrangler deploy",
    "db:deploy": "dotenv -e .env.local -- prisma migrate deploy"
  },
  "dependencies": {
    "@nsheth/admin": "*",
    "@nsheth/booking": "*",
    "@nsheth/commerce": "*",
    "@nsheth/content": "*",
    "@nsheth/hospitality": "*",
    "@nsheth/identity": "*",
    "@nsheth/product": "*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/match-sorter-utils": "9.1.2",
    "@tanstack/query-db-collection": "1.2.12",
    "@tanstack/react-db": "0.3.7",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-hotkeys": "0.10.0",
    "@tanstack/react-pacer": "0.23.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.49",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/store": "0.11.1",
    "@untitledui/icons": "0.0.22",
    "react": "19.2.8",
    "react-aria-components": "1.21.0",
    "react-dom": "19.2.8",
    "stripe": "22.6.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animate": "1.0.7",
    "tailwindcss-react-aria-components": "2.2.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-event-client": "0.5.0",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "1.167.33",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "@prisma/engines",
      "prisma"
    ]
  },
  "version": "0.8.5"
}
