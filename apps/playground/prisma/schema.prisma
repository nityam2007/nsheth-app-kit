generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Service {
  id String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique
  summary String
  description String @db.Text
  status ProductStatus @default(DRAFT)
  durationMinutes Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  slots AvailabilitySlot[]
}

model AvailabilitySlot {
  id String @id @default(uuid()) @db.Uuid
  serviceId String @db.Uuid
  startsAt DateTime
  endsAt DateTime
  capacity Int
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookings BookingRequest[]
  @@unique([serviceId, startsAt])
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
}

model Property {
  id String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique
  summary String
  description String @db.Text
  location String
  timezone String @default("Asia/Kolkata")
  status ProductStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rooms RoomType[]
}

model RoomType {
  id String @id @default(uuid()) @db.Uuid
  propertyId String @db.Uuid
  name String
  description String
  inventory Int
  maxGuests Int
  nightlyRate Int
  active Boolean @default(true)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservations Reservation[]
}

model Reservation {
  id String @id @default(uuid()) @db.Uuid
  roomTypeId String @db.Uuid
  checkIn DateTime @db.Date
  checkOut DateTime @db.Date
  guests Int
  name String
  email String
  totalAmount Int
  currency String @default("INR")
  status BookingStatus @default(REQUESTED)
  createdAt DateTime @default(now())
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  @@index([roomTypeId, status, checkIn, checkOut])
}

model BookingRequest {
  id String @id @default(uuid()) @db.Uuid
  slotId String @db.Uuid
  name String
  email String
  notes String @db.Text
  status BookingStatus @default(REQUESTED)
  createdAt DateTime @default(now())
  slot AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  @@index([slotId, status])
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  slug        String        @unique
  summary     String
  description String        @db.Text
  status      ProductStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  enquiries   Enquiry[]
  price Int @default(0)
  stock Int @default(0)
  forSale Boolean @default(false)
  category String @default("")
  imageUrl String @default("")
  orderLines OrderLine[]

  @@index([status, publishedAt])
}

enum OrderStatus {
  PLACED
  FULFILLED
  CANCELLED
}

model Order {
  id String @id @default(uuid()) @db.Uuid
  requestHash String @unique
  payloadHash String
  name String
  email String
  address String
  totalAmount Int
  currency String @default("INR")
  status OrderStatus @default(PLACED)
  paid Boolean @default(false)
  createdAt DateTime @default(now())
  lines OrderLine[]
}

model OrderLine {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  productId String @db.Uuid
  name String
  quantity Int
  price Int
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
  @@index([orderId])
}

model Enquiry {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  name      String
  email     String
  quantity  Int
  message   String   @db.Text
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
}

model Post {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  slug        String     @unique
  excerpt     String
  body        String     @db.Text
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  email     String     @unique
  name      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  sessions Session[]
  roles     UserRole[]
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  name        String
  createdAt   DateTime         @default(now())
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id        String           @id @default(uuid()) @db.Uuid
  key       String           @unique
  name      String
  createdAt DateTime         @default(now())
  roles     RolePermission[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId      String     @db.Uuid
  permissionId String     @db.Uuid
  assignedAt   DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}
